SELECT C.I_CASE as caseNumber, C.I_ACQ_REFNCE_NUM as acqRefnceNum, C.I_CASE as caseNumber,C.D_CASE_STRT as caseStartDate,C.D_CASE_END as caseEndDate, C.A_DISPUTE_ORIG as disputeOrig,C.I_DESK as desk,C.C_CASE_SPECIAL_HANDLING as caseSpecialHandling,C.C_NTWK_CASE_ID as ntwkCaseId, C.I_CASE_ACTION_MAX_SEQ as caseActionMaxSeq,C.C_CASE_STA as caseStatus,C.C_CASE_NTWK as caseNetwork,C.C_CASE_WRKFLW_TYPE as workflowType, C.I_SOURCE_ICA as sourceIca,C.I_DESTINATION_ICA as destinationIca,C.C_PRODUCT_TYPE as productType,C.C_PRODUCT_SUB_TYPE as productSubType, C.C_SIG_PIN as sigPin,C.I_ISSUER_BIN as issuerBin,C.C_CASE_FINAL_LIABILITY as caseFinalLiability,C.C_LEVEL1_ENTITY as level1Entity, C.C_ENRICH_FAILURE as failedEnrichment, C.C_LEVEL2_ENTITY as level2Entity,C.C_LEVEL3_ENTITY as level3Entity,C.C_LEVEL4_ENTITY as level4Entity,C.C_LEVEL5_ENTITY as level5Entity, C.C_LEVEL6_ENTITY as level6Entity,C.C_LEVEL7_ENTITY as level7Entity,C.C_LEVEL8_ENTITY as level8Entity,C.C_LEVEL9_ENTITY as level9Entity,C.C_LEVEL10_ENTITY as level10Entity, C.C_LEVEL11_ENTITY as level11Entity,C.C_MERCHANT_NAME as merchantName,C.C_STE as state,C.N_CITY as city,C.C_CNTRY as country, C.C_MCC as mcc,C.I_NTWK_TRAN_ID as networkTranId,C.C_MRCHNT_ORDER_ID as mrchntOrderId,C.C_TR_TYPE as trType,C.D_TR as tr,C.A_PURCHASE_AMT as purchaseAmt, C.C_PURCHASE_CURRENCY as purchaseCurrency,C.I_PURCHASE_AMT_EXPONENT as purchaseAmtExpo,C.I_WPY_SETTLE_TRANID as wpySettleTranid,C.C_CHECKOUT_ID as checkoutId, C.I_ACCT_CDH_LST as acctCdhLst,C.I_ACCT_CDH as acctCdh,C.A_CNVERTED_PURCHASE_AMT as cnvertedPurchaseAmt,C.C_CNVERTED_PURCHASE_AMT_CURRENCY as cnvertedPurchaseAmtCurrency,C.I_CNVERTED_PURCHASE_AMT_EXPONENT as cnvertedPurchaseAmtExpo, C.C_ENTRY_MODE as entryMode,C.C_AVS_RESP as avsResp,C.I_RGSTR as rgstr,C.C_TOKEN as token,A.c_migration_sta as migrationStatus,A.I_ACTION_SEQ as actionSeq,A.C_SOURCE_CASE_ID as sourceCaseId,A.A_DISPUTE_AMT as disputeAmount, A.C_DISPUTE_CURRENCY as disputeCurrency,A.I_DISPUTE_CURRENCY_EXPONENT as disputeAmtExponent,A.C_NTWK_CHBK_REFNCE as networkChbkReferance,A.D_ACTION_PROCESSED as actionProcessedDate, A.D_ACTION_PROCESSED_EST as actionProcessedESTDate, A.C_ISSUER_DOC_IND as issuerDocIndicator,A.C_MRCH_DOC_IND as merchantDocIndicator,A.D_RESPONSE_DUE as responseDueDate,A.D_EXPIRY_DUE as expiryDueDate, A.D_ACTION_REPORTED as actionReportedDate,A.C_ACTION_IN_OUT as actionInOut,A.C_PARTIAL as partialAmountIndicator,A.C_PRE_NOTE as preNoteIndicator,A.C_OWNR as owner, A.x_dspt_amt_sgn as dsptAmountSign,A.C_REJECT_REASON2 as secondRejectReason,A.D_REJECT as rejectDate,A.C_NTWRK_PHASE_ID as networkPhaseId, A.C_CASE_STAGE as caseStage,A.C_ACTION_TYPE as actionType,A.C_REASON as reasonCode,A.X_UPDT as updatedBy,A.Z_UPDT as updatedTimestamp, C.C_INPUT_METHOD as inputMethod,A.C_TIMEFRAME_EXPIRED_IND as timeframeExpiredInd,A.A_DISPUTE_WORKABLE_AMT as disputeWorkableAmount,A.C_DISPUTE_WORKABLE_CURRENCY as disputeWorkableCurrency, C.C_ACQ_PLATFORM as platform, A.C_REVRSL_IND as reversalIndicator, A.C_SPEC_HANDLING as specHandling, C.C_ASSIGNMENT_RSN as assingmentReason, C.C_MERCHANT_REF_NUMBER as merchantRefNumber,C.c_acro_frm as fromAcro,C.c_acro_to as toAcro,C.C_CVV as cvv,A.c_incomng_partial as incomingPartialInd, A.c_network_doc_ind as networkDocInd,A.i_dispute_workable_currency_exponent as disputeWorkableAmountExponent, A.a_cnverted_dispute_amt as convertedDisputeAmount,A.c_cnverted_dispute_amt_currency as convertedDisputeAmountCurrency,A.a_cnverted_dispute_exponent as convertedDisputeAmountExponent, A.a_post_amt as disputeSettlementAmount,A.c_post_currency as disputeSettlementAmountCurrency,A.i_post_amt_exponent as disputeSettlementAmountExponent,c.d_cse_ready as caseReadyDate, A.C_ACTION_STA as actionStatus, C.I_TICKET_NUMBER as ticketNumber, C.C_AUTH_TR as authCode, C.i_pan_first6_last4 as panFirst6Last4, C.C_CUST_FIELD1 as customerField1,C.T_CUST_DSCRTN_2 as customerField2,C.T_CUST_DSCRTN_3 as customerField3, C.D_TR_TIMESTAMP as transactionTimestamp, C.D_DEPARTURE as departureDate, C.C_INVOICE as invoiceNumber, A.i_action_id as actionId, A.c_reason_category as reasonCategory, A.z_insrt AT TIME ZONE 'UTC' AT TIME ZONE 'America/New_York' as actionTimestamp, C.c_au_pan as accountUpdaterPAN, C.c_au_hash_pan as accountUpdaterHashPAN, C.c_sls_pers_id as salesPersonId, A.x_insrt as createdBy, A.x_updt as lastUpdatedBy, A.x_insrt_display as insertedDisplayId, A.x_updt_display as updatedDisplayId, A.C_FUNCTION_CODE as functionCode, CASE WHEN cl.i_case IS NOT NULL THEN 'Y' ELSE NULL END AS caseLock, cl.locked_by AS lockedBy , case when A.C_ACTION_STA != 'CLOSED' THEN 1 when A.C_ACTION_STA = 'CLOSED' THEN 2 end AS sort_order_1, case when A.C_ACTION_STA = 'CLOSED' then -1 when A.D_EXPIRY_DUE is null or A.D_EXPIRY_DUE <= CURRENT_DATE THEN 0 else A.D_EXPIRY_DUE - CURRENT_DATE end AS sort_order_2 FROM wdp.case c INNER JOIN wdp.action a ON c.I_CASE_ID = a.I_CASE_ID LEFT JOIN wdp.case_lock cl ON c.i_case = cl.i_case WHERE A.c_action_sta IN ('OPEN', 'ERROR', 'CLOSED') AND A.D_ACTION_PROCESSED_EST BETWEEN DATE '2026-10-05' AND DATE '2026-10-05' AND C.C_ACQ_PLATFORM IN (:us_largest_plat) AND C.c_case_sta IN ('OPEN','CLOSED') AND :us_largest_pred ORDER BY actionProcessedESTDate, actionId ASC LIMIT 200 OFFSET 0;
\o :outdir/:setup-us-largest-1d-page.txt
\qecho '# setup=' :'setup' ' cell=us-largest-1d-page'
EXPLAIN (ANALYZE, BUFFERS, SETTINGS)
