WITH LATEST_ACTIONS AS ( SELECT C.I_CASE as caseNumber FROM wdp.case c INNER JOIN wdp.action a ON c.I_CASE_ID = a.I_CASE_ID LEFT JOIN wdp.case_lock cl ON c.i_case = cl.i_case WHERE A.c_action_sta IN ('OPEN', 'ERROR', 'CLOSED') AND A.D_ACTION_PROCESSED_EST BETWEEN DATE '2026-10-05' AND DATE '2026-10-05' AND C.C_ACQ_PLATFORM IN (:us_median_plat) AND C.c_case_sta IN ('OPEN','CLOSED') AND :us_median_pred ) SELECT count(*) FROM LATEST_ACTIONS LIMIT 1;
\o :outdir/:setup-us-median-1d-count.txt
\qecho '# setup=' :'setup' ' cell=us-median-1d-count'
EXPLAIN (ANALYZE, BUFFERS, SETTINGS)
WITH LATEST_ACTIONS AS ( SELECT C.I_CASE as caseNumber FROM wdp.case c INNER JOIN wdp.action a ON c.I_CASE_ID = a.I_CASE_ID LEFT JOIN wdp.case_lock cl ON c.i_case = cl.i_case WHERE A.c_action_sta IN ('OPEN', 'ERROR', 'CLOSED') AND A.D_ACTION_PROCESSED_EST BETWEEN DATE '2026-10-05' AND DATE '2026-10-05' AND C.C_ACQ_PLATFORM IN (:us_median_plat) AND C.c_case_sta IN ('OPEN','CLOSED') AND :us_median_pred ) SELECT count(*) FROM LATEST_ACTIONS LIMIT 1;
