DEPARTURE as departureDate, C.C_INVOICE as invoiceNumber, A.i_action_id as actionId, A.c_reason_category as reasonCategory, A.z_insrt AT TIME ZONE 'UTC' AT TIME ZONE 'America/New_York' as actionTimestamp, C.c_au_pan as accountUpdaterPAN, C.c_au_hash_pan as accountUpdaterHashPAN, C.c_sls_pers_id as salesPersonId, A.x_insrt as createdBy, A.x_updt as lastUpdatedBy, A.x_insrt_display as insertedDisplayId, A.x_updt_display as updatedDisplayId, A.C_FUNCTION_CODE as functionCode, CASE WHEN cl.i_case IS NOT NULL THEN 'Y' ELSE NULL END AS caseLock, cl.locked_by AS lockedBy , case when A.C_ACTION_STA != 'CLOSED' THEN 1 when A.C_ACTION_STA = 'CLOSED' THEN 2 end AS sort_order_1, case when A.C_ACTION_STA = 'CLOSED' then -1 when A.D_EXPIRY_DUE is null or A.D_EXPIRY_DUE <= CURRENT_DATE THEN 0 else A.D_EXPIRY_DUE - CURRENT_DATE end AS sort_order_2 FROM wdp.case c INNER JOIN wdp.action a ON c.I_CASE_ID = a.I_CASE_ID LEFT JOIN wdp.case_lock cl ON c.i_case = cl.i_case WHERE A.c_action_sta IN ('OPEN', 'ERROR', 'CLOSED') AND A.D_ACTION_PROCESSED_EST BETWEEN DATE '2026-08-06' AND DATE '2026-10-05' AND C.C_ACQ_PLATFORM IN (:us_largest_plat) AND C.c_case_sta IN ('OPEN','CLOSED') AND :us_largest_pred ORDER BY actionProcessedESTDate, actionId ASC LIMIT 200 OFFSET 0;
