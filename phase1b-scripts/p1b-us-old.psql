\echo 'us-large-60d-page-deep (offset from the old count)'
BEGIN TRANSACTION READ ONLY;
SET LOCAL statement_timeout = '10min';
SET LOCAL lock_timeout = '5s';
SELECT GREATEST(((n / 200) - 1) * 200, 0) AS deep_off, (n >= 400) AS do_deep FROM (
WITH LATEST_ACTIONS AS ( SELECT C.I_CASE as caseNumber FROM wdp.case c INNER JOIN wdp.action a ON c.I_CASE_ID = a.I_CASE_ID LEFT JOIN wdp.case_lock cl ON c.i_case = cl.i_case WHERE A.c_action_sta IN ('OPEN', 'ERROR', 'CLOSED') AND A.D_ACTION_PROCESSED_EST BETWEEN DATE '2026-08-06' AND DATE '2026-10-05' AND C.C_ACQ_PLATFORM IN (:us_large_plat) AND C.c_case_sta IN ('OPEN','CLOSED') AND :us_large_pred ) SELECT count(*) FROM LATEST_ACTIONS LIMIT 1
) s(n) \gset
ROLLBACK;
