SELECT CASE WHEN idempotency_id IS NULL THEN 'no id'
            WHEN count(*) OVER (PARTITION BY idempotency_id) > 1 THEN 'shared id'
            ELSE 'own id' END AS id_group,
       status,
       count(*) AS row_count,
       min(id) AS lowest_row_id,
       max(id) AS highest_row_id
FROM wdp.ai_response_events
WHERE status <> 'TRACKER'
GROUP BY 1, status
ORDER BY 1, status;
