SELECT row_to_json(t)
FROM (
  SELECT cd.dispute_case_id, cd.document_ref, cd.declared_side, dt.*
  FROM wdp_ai.case_document cd
  JOIN wdp_ai.document_text dt ON dt.case_document_id = cd.id
  WHERE cd.dispute_case_id IN ('N232D3470118', 'N252A3543865' /* ...the rest */)
  ORDER BY cd.dispute_case_id, cd.document_ref
) t;



psql -h <host> -d <db> -U <user> -At -f query.sql > document_text.jsonl


SELECT to_jsonb(cr) - 'ops_letter' - 'network_letter' - 'prompt_snapshot'
FROM wdp_ai.classifier_run cr
WHERE cr.case_number IN (
  'N232D3470118','N252A3543865','N268X1574364','N322A3646743','N334H3655997',
  'N450N3519993','N475M4118187','N483T1471700','N487A3543871','N4997D931860',
  'N595A3453892','N608B1727377','N610W3451447','N678Y4778864','N714P3488468',
  'N727V1458827','N764S3560077','N832B3710574','N876S3736295','N925V4234714',
  'N976I3869042'
)
ORDER BY cr.case_number, cr.created_at;



SELECT ef.dispute_case_id,
       ef.reader_version      AS fact_reader,
       max(dt.reader_version) AS doc_reader,
       ef.reader_version = max(dt.reader_version) AS same
FROM wdp_ai.extracted_fact ef
JOIN wdp_ai.document_text dt ON dt.case_document_id = ef.case_document_id
WHERE ef.dispute_case_id IN ('N475M4118187','N483T1471700','N678Y4778864','N876S3736295')
GROUP BY ef.dispute_case_id, ef.reader_version;


SELECT case_number, id, created_at, decision, lead_code
FROM wdp_ai.classifier_run
WHERE case_number IN ('N475M4118187','N483T1471700','N678Y4778864','N876S3736295')
ORDER BY case_number, created_at;



SELECT r.code, r.role, tl.conditions
FROM wdp_ai.requirement r
JOIN wdp_ai.reason_code rc ON rc.id = r.reason_code_id
LEFT JOIN wdp_ai.requirement_time_limit tl ON tl.requirement_id = r.id
WHERE rc.code = '13.1'
  AND (r.code LIKE '%G34' OR r.code LIKE '%G32' OR r.code LIKE '%G33'
       OR r.code LIKE '%G28' OR r.code LIKE '%G42');
